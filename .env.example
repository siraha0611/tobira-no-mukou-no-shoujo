# 必須: Anthropic API キー (https://console.anthropic.com/ で取得)
ANTHROPIC_API_KEY=sk-ant-ここにあなたのキー

# ── 以下は任意(既定値のままで動きます) ──────────────────
# 会話モデル(品質を上げたい場合は claude-sonnet-4-6 など)
#CLAUDE_MODEL=claude-haiku-4-5

# サーバポート
#PORT=8138

# 扉が開くまでの最低会話ターン数
#MIN_TURNS=8

# 声を使わない場合は off
#TTS_MODE=auto

# VOICEVOX / AivisSpeech(起動していれば自動検出)
#VOICEVOX_HOST=http://127.0.0.1:50021
#VOICEVOX_SPEAKER=14
#AIVIS_HOST=http://127.0.0.1:10101
#AIVIS_SPEAKER=1878365376

# マイク入力(whisper.cpp)
#WHISPER_BIN=whisper-cli
#WHISPER_MODEL=~/.local/share/whisper-cpp/ggml-large-v3-turbo-q5_0.bin

# 会話記録の保存(研究用途。1で有効)
#SAVE_TRANSCRIPTS=0
